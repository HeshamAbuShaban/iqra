# Build / IDE
*.iml
.gradle/
build/
*/build/
local.properties
.gradle*
captures/
.externalNativeBuild/
.cxx/

# Bundled model + token tables (fetched by scripts/fetch_assets.sh, ~100 MB)
/android/app/src/main/assets/

# Reverse-engineering working artifacts (kept local only)
/re/
/tools/*
/apk/
/work/

# ...except the launcher icon master. It is a 2 KB source file and the Android
# vector drawables are transcriptions of it, so without it in the repository the
# only copy of the design lives on one machine and the drawables become
# unreviewable.
#
# The pattern has to re-include each level of the path in turn: git does not
# descend into an excluded directory at all, so negating a file inside
# /tools/icon/ can only work if /tools/icon/ itself is first re-included.
# Rendered previews stay ignored - they are regenerated from the SVG with
# rsvg-convert, at 48/96/192/432px.
/tools/*
!/tools/icon/
/tools/icon/*
!/tools/icon/iqra.svg

# Node prototype (rejected web PWA + local proofs); see reference/ for the kept proof
# NOTE: engine/replay/ IS tracked - it is the project's only measurement loop.
/engine/*
!/engine/replay/
# Recorded recitation clips for the hesitation harness: keep the format notes,
# never the audio. The raw/ and *.wav stay ignored.
!/engine/audio/
/engine/audio/*
!/engine/audio/hesitate/
/engine/audio/hesitate/*
!/engine/audio/hesitate/README.md

/engine/replay/out/
/engine/.venv-replay/

# Node prototype (optional reference only)
/engine/node_modules/
/engine/*.onnx
/engine/*.raw

# OS / misc
.DS_Store
Thumbs.db
*.log

# Vendored reference (not committed)
/reference/tarteel-ml/
/reference/quran_android/
__pycache__/
*.pyc

# Locally staged heavy data for adb/USB push (never committed)
/.iqra-stage/

# Rendered icon previews (regenerate: see tools/icon/iqra.svg)
/tools/icon/preview/
