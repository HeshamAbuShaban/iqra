<?xml version="1.0" encoding="utf-8"?>
<!-- Declares the app's supported UI languages for Android 13's per-app
     language picker in system settings. The in-app picker (AppLocales) writes
     the same system store on 33+. -->
<locale-config xmlns:android="http://schemas.android.com/apk/res/android">
    <locale android:name="en" />
    <locale android:name="ar" />
</locale-config>
