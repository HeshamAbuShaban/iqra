<?xml version="1.0" encoding="utf-8"?>
<!--
    Open mushaf with one line resolved.

    Geometry is transcribed from tools/icon/iqra.svg, which is the master copy
    and is rendered and reviewed at 48/96/192/432px before any of this is
    believed. Keep the two in step: the SVG is the thing that can be looked at.

    Authored on the 108 adaptive grid. All ink sits inside 21..87, which is the
    66dp safe zone - a circular launcher mask clips anything outside it, which is
    why the block does not run to the full 108 even though it could.

    One line is heavier, gold and full measure; three recede. That difference in
    weight is the whole product in one mark, and it is a difference rather than
    a detail because a detail does not survive the launcher grid.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- left page: outer edge y 29..77, spine edge y 34..81, so the two pages
         close into a single V at the gutter -->
    <path android:pathData="M21,29 Q36.5,29.5 52.4,34 L52.4,81 Q36.5,77 21,77 Z">
        <aapt:attr name="android:fillColor">
            <gradient android:type="linear"
                android:startX="21" android:startY="35"
                android:endX="52.4" android:endY="60">
                <item android:offset="0" android:color="#FCF8EC" />
                <item android:offset="1" android:color="#EADFC4" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- right page, mirrored about x=54 -->
    <path android:pathData="M87,29 Q71.5,29.5 55.6,34 L55.6,81 Q71.5,77 87,77 Z">
        <aapt:attr name="android:fillColor">
            <gradient android:type="linear"
                android:startX="87" android:startY="35"
                android:endX="55.6" android:endY="60">
                <item android:offset="0" android:color="#FCF8EC" />
                <item android:offset="1" android:color="#EADFC4" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- receded lines: identical measure on both pages, muted -->
    <group>
        <path android:pathData="M27,44 H47" android:strokeColor="#BFA070"
            android:strokeWidth="2.6" android:strokeLineCap="round"
            android:strokeAlpha="0.7" />
        <path android:pathData="M61,44 H81" android:strokeColor="#BFA070"
            android:strokeWidth="2.6" android:strokeLineCap="round"
            android:strokeAlpha="0.7" />
        <path android:pathData="M27,62 H47" android:strokeColor="#BFA070"
            android:strokeWidth="2.6" android:strokeLineCap="round"
            android:strokeAlpha="0.7" />
        <path android:pathData="M61,62 H81" android:strokeColor="#BFA070"
            android:strokeWidth="2.6" android:strokeLineCap="round"
            android:strokeAlpha="0.7" />
        <path android:pathData="M27,71 H47" android:strokeColor="#BFA070"
            android:strokeWidth="2.6" android:strokeLineCap="round"
            android:strokeAlpha="0.7" />
        <path android:pathData="M61,71 H81" android:strokeColor="#BFA070"
            android:strokeWidth="2.6" android:strokeLineCap="round"
            android:strokeAlpha="0.7" />
    </group>

    <!-- the resolved line -->
    <path android:pathData="M27,53 H47" android:strokeColor="#C08A2E"
        android:strokeWidth="5" android:strokeLineCap="round" />
    <path android:pathData="M61,53 H81" android:strokeColor="#C08A2E"
        android:strokeWidth="5" android:strokeLineCap="round" />

    <!-- spine: flat band plus a lighter core, so it reads as a crease -->
    <path android:pathData="M52.4,34 h3.2 v47 h-3.2 Z" android:fillColor="#A87F33" />
    <path android:pathData="M52.4,34 h1.1 v47 h-1.1 Z"
        android:fillColor="#D9B36B" android:fillAlpha="0.8" />
</vector>